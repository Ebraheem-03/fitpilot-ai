{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "needs_review",
        "superseded"
      ]
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "validation_issues": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "generation_failed",
              "schema",
              "reps_or_duration",
              "days_distinct",
              "duplicate_exercise",
              "catalogue",
              "equipment",
              "days_count",
              "prescription",
              "session_length"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "days": {
              "minItems": 1,
              "maxItems": 7,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "day_of_week": {
                    "type": "string",
                    "enum": [
                      "monday",
                      "tuesday",
                      "wednesday",
                      "thursday",
                      "friday",
                      "saturday",
                      "sunday"
                    ]
                  },
                  "focus": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "exercises": {
                    "minItems": 1,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "exercise_id": {
                          "type": "string",
                          "maxLength": 64,
                          "pattern": "^[a-z0-9_]+$"
                        },
                        "sets": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 6
                        },
                        "reps": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 30
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "duration_s": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 10,
                              "maximum": 180
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "rest_s": {
                          "type": "integer",
                          "minimum": 15,
                          "maximum": 240
                        },
                        "progression": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "required": [
                        "exercise_id",
                        "sets",
                        "reps",
                        "duration_s",
                        "rest_s",
                        "progression"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "day_of_week",
                  "focus",
                  "exercises"
                ],
                "additionalProperties": false
              }
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "required": [
            "days",
            "rationale"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "prompt_version",
    "model",
    "created_at",
    "validation_issues",
    "plan"
  ],
  "additionalProperties": false
}

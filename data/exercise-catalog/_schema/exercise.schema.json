{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_muscles": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "camera_views": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["side", "front", "front_45"]
      }
    },
    "animation": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+\\.glb$"
        },
        "clip": {
          "type": "string",
          "minLength": 1
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "phases": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "instruction_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "required": ["phase", "start_s", "end_s", "instruction_indices"],
            "additionalProperties": false
          }
        }
      },
      "required": ["asset", "clip", "duration_s", "phases"],
      "additionalProperties": false
    },
    "supported_capabilities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["pose_tracking", "rep_counting", "phase_detection", "rule_based_feedback"]
      }
    },
    "required_landmarks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "nose",
          "left_shoulder",
          "right_shoulder",
          "left_elbow",
          "right_elbow",
          "left_wrist",
          "right_wrist",
          "left_hip",
          "right_hip",
          "left_knee",
          "right_knee",
          "left_ankle",
          "right_ankle",
          "left_heel",
          "right_heel",
          "left_foot_index",
          "right_foot_index"
        ]
      }
    },
    "ruleset_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "phases": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instructions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technique_considerations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "equipment",
    "target_muscles",
    "camera_views",
    "animation",
    "supported_capabilities",
    "required_landmarks",
    "ruleset_version",
    "phases",
    "instructions",
    "technique_considerations"
  ],
  "additionalProperties": false
}

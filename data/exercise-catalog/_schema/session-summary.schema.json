{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "exercises": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "exercise_id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "skipped"
            ]
          },
          "skip_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "no_equipment",
                  "too_difficult",
                  "discomfort",
                  "no_time",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "prescription": {
            "type": "string",
            "enum": [
              "reps",
              "duration"
            ]
          },
          "tracked": {
            "type": "boolean"
          },
          "sets": {
            "maxItems": 51,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "set_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 50
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "tracked",
                    "manual"
                  ]
                },
                "reps": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "duration_s": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "perceived_difficulty": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "set_index",
                "source",
                "reps",
                "duration_s",
                "perceived_difficulty"
              ],
              "additionalProperties": false
            }
          },
          "total_reps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total_duration_s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cues": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
                },
                "ruleset_version": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "message_id": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9_]+$"
                },
                "shown_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "measurements": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "maxLength": 48,
                    "pattern": "^[a-z0-9_]+$"
                  },
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "response": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "acknowledged",
                        "dismissed"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "rule_id",
                "ruleset_version",
                "message_id",
                "shown_at",
                "measurements",
                "response"
              ],
              "additionalProperties": false
            }
          },
          "tracking_degraded": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string",
                  "enum": [
                    "low_visibility",
                    "out_of_frame",
                    "low_light",
                    "unsupported_view",
                    "no_person",
                    "slow_device"
                  ]
                },
                "started_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "reason",
                "started_at",
                "duration_ms"
              ],
              "additionalProperties": false
            }
          },
          "perceived_difficulty": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "exercise_id",
          "status",
          "skip_reason",
          "prescription",
          "tracked",
          "sets",
          "total_reps",
          "total_duration_s",
          "cues",
          "tracking_degraded",
          "perceived_difficulty",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "perceived_difficulty": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "session_id",
    "started_at",
    "completed_at",
    "exercises",
    "perceived_difficulty",
    "note"
  ],
  "additionalProperties": false
}

# Copy to .env (never commit .env). Values here are placeholders only.

# --- Web (Next.js) — NEXT_PUBLIC_* is shipped to the browser, never put secrets there
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# --- API (FastAPI)
FITPILOT_ENV=local
DATABASE_URL=postgresql+psycopg://fitpilot:fitpilot@localhost:5432/fitpilot
SUPABASE_JWT_SECRET=replace-me
CORS_ORIGINS=http://localhost:3000

# --- LLM provider (behind app/services/llm abstraction — see ADR-0004)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=replace-me
LLM_MONTHLY_BUDGET_USD=5

# --- Observability (optional)
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- MCP servers used by Claude Code (set in your shell, not here, if you prefer)
CONTEXT7_API_KEY=

# Copy to .env (never commit .env). Values here are placeholders only.

# --- Web (Next.js) — NEXT_PUBLIC_* is shipped to the browser, never put secrets there
# The API also uses this URL to fetch the project's JWKS (ADR-0003); no JWT secret needed.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# Publishable key (sb_publishable_…), not the legacy JWT anon key (ADR-0003).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me

# --- API (FastAPI)
# Where the web server sends users' bearer tokens. Server-only (never NEXT_PUBLIC_).
API_BASE_URL=http://localhost:8000
FITPILOT_ENV=local
DATABASE_URL=postgresql+psycopg://fitpilot:fitpilot@localhost:5432/fitpilot
CORS_ORIGINS=http://localhost:3000

# --- LLM provider (behind app/services/llm abstraction — see ADR-0004, ADR-0006)
# Zero-cost default: Groq free tier (no card). Enable Zero Data Retention in the Groq console.
# Tests/CI: LLM_PROVIDER=fake. Private local dev: LLM_PROVIDER=ollama.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=replace-me
# 0 = paid providers are refused (guard fails closed). Only raise it if you add a paid provider.
LLM_MONTHLY_BUDGET_USD=0
# Optional paid provider, unused at $0: LLM_PROVIDER=anthropic, LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- Observability (optional)
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- MCP servers used by Claude Code (set in your shell, not here, if you prefer)
CONTEXT7_API_KEY=
